generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SOSStatus {
  ACTIVE
  RESOLVED
  CANCELLED
}

enum EvidenceType {
  IMAGE
  AUDIO
  VIDEO
}

model User {
  id         String  @id @default(uuid())
  fullName   String
  email      String  @unique
  password   String
  phone      String? @unique
  profilePic String?
  isVerified Boolean @default(false)

  fcmToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emergencyContacts EmergencyContact[]
  sosAlerts         SOSAlert[]
  evidences         Evidence[]
}

model EmergencyContact {
  id          String  @id @default(uuid())
  name        String
  phone       String
  relation    String
  isPrimary   Boolean @default(false)
  countryCode String  @default("+91")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SOSAlert {
  id        String    @id @default(uuid())
  latitude  Float
  longitude Float
  status    SOSStatus @default(ACTIVE)
  message   String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  evidences Evidence[]
}

model Evidence {
  id     String @id @default(uuid())
  userId String
  sosId  String

  type EvidenceType

  fileName String
  fileUrl  String
  publicId String?

  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sos  SOSAlert @relation(fields: [sosId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sosId])
}
